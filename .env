# ==========================================
# Frontend Variables (React/Vite)
# (Must start with VITE_ to be exposed to React)
# ==========================================

VITE_API_URL=http://127.0.0.1:8000
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==========================================
# Backend Variables (Django)
# ==========================================

# Environment type (development / production)
DJANGO_ENV=development

# The URL where your React frontend is running (used for CORS and emails)
FRONTEND_URL=http://localhost:5173

# Email Configuration (for sending password resets / notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
